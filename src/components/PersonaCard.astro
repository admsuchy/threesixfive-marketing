---
interface Props {
  role: string;
  headline: string;
  description: string;
  bullets?: string[];
  index?: number;
  icon?: string;
}
const { role, headline, description, bullets = [], index = 0, icon } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<article class="group relative p-8 md:p-10 border border-brand-line rounded-2xl bg-brand-surface/60 hover:bg-brand-surface hover:border-brand-primary/60 transition-all duration-300 flex flex-col">
  <div class="flex items-start justify-between mb-6">
    {icon && (
      <div class="w-11 h-11 rounded-full bg-brand-primary/15 text-brand-primary flex items-center justify-center group-hover:bg-brand-primary group-hover:text-black transition-colors">
        <Fragment set:html={icon} />
      </div>
    )}
    <span class="text-xs font-mono text-brand-subtle tabular-nums ml-auto">{num}</span>
  </div>
  <p class="text-xs uppercase tracking-[0.22em] text-brand-primary font-medium mb-3">{role}</p>
  <h3 class="text-2xl md:text-3xl mb-3 text-brand-ink">{headline}</h3>
  <p class="text-sm md:text-base text-brand-muted leading-relaxed mb-5">{description}</p>
  {bullets.length > 0 && (
    <ul class="mt-auto space-y-2 text-sm text-brand-muted">
      {bullets.map((b) => (
        <li class="flex gap-2">
          <span class="text-brand-primary mt-1">&bull;</span>
          <span>{b}</span>
        </li>
      ))}
    </ul>
  )}
</article>
