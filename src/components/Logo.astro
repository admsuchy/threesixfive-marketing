---
interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}
const { class: className = '', size = 'md' } = Astro.props;

const sizes = {
  sm: 'text-xl md:text-2xl',
  md: 'text-2xl md:text-3xl',
  lg: 'text-4xl md:text-5xl',
};
---

<a
  href="/"
  class={`inline-flex items-center gap-2 group ${className}`}
  aria-label="365 home"
>
  <span
    class={`display-xl ${sizes[size]} text-brand-ink tracking-tightest group-hover:text-brand-primary transition-colors`}
  >
    365
  </span>
  <span aria-hidden="true" class="hidden sm:inline-block w-1 h-1 rounded-full bg-brand-primary"></span>
</a>
