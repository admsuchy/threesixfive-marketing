---
interface Props {
  label: string;
  tone?: 'paid' | 'active' | 'pending' | 'cancelled' | 'review' | 'photos' | 'open';
  size?: 'xs' | 'sm';
}
const { label, tone = 'pending', size = 'xs' } = Astro.props;

const tones: Record<NonNullable<Props['tone']>, string> = {
  paid: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30',
  active: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30',
  pending: 'bg-orange-500/15 text-orange-300 border-orange-500/30',
  photos: 'bg-orange-500/15 text-orange-300 border-orange-500/30',
  review: 'bg-sky-500/15 text-sky-300 border-sky-500/30',
  open: 'bg-zinc-500/20 text-zinc-300 border-zinc-500/30',
  cancelled: 'bg-zinc-700/40 text-zinc-400 border-zinc-700/60',
};

const sizes = {
  xs: 'text-[10px] px-2 py-0.5',
  sm: 'text-[11px] px-2.5 py-1',
};
---

<span
  class={`inline-flex items-center gap-1 rounded-full border font-medium uppercase tracking-wider whitespace-nowrap ${tones[tone]} ${sizes[size]}`}
>
  <span class="w-1 h-1 rounded-full bg-current opacity-80"></span>
  {label}
</span>
