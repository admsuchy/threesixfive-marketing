---
interface Props {
  data: { label: string; value: number }[];
  accent?: string;
  height?: number;
  showLabels?: boolean;
  title?: string;
}
const {
  data,
  accent = '#F97316',
  height = 90,
  showLabels = true,
  title,
} = Astro.props;

const max = Math.max(...data.map((d) => d.value), 1);
const width = 280;
const barGap = 6;
const barWidth = (width - barGap * (data.length - 1)) / data.length;
---

<div class="rounded-xl border border-zinc-700/50 bg-zinc-800/60 p-3 backdrop-blur">
  {title && (
    <p class="text-[10px] uppercase tracking-wider text-zinc-500 font-medium mb-2">
      {title}
    </p>
  )}
  <svg
    viewBox={`0 0 ${width} ${height + (showLabels ? 14 : 0)}`}
    class="w-full h-auto"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="barChartGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color={accent} stop-opacity="0.9" />
        <stop offset="100%" stop-color={accent} stop-opacity="0.4" />
      </linearGradient>
    </defs>
    {data.map((d, i) => {
      const h = (d.value / max) * height;
      const x = i * (barWidth + barGap);
      const y = height - h;
      return (
        <g>
          <rect
            x={x}
            y={y}
            width={barWidth}
            height={h}
            rx="3"
            fill="url(#barChartGrad)"
          />
          {showLabels && (
            <text
              x={x + barWidth / 2}
              y={height + 11}
              text-anchor="middle"
              class="fill-zinc-500"
              style="font-size:8px; font-family: ui-monospace, monospace;"
            >
              {d.label}
            </text>
          )}
        </g>
      );
    })}
  </svg>
</div>
