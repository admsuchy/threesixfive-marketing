---
interface Props {
  label: string;
  value: string;
  trend?: string;
  trendDir?: 'up' | 'down' | 'flat';
  accent?: boolean;
  size?: 'sm' | 'md';
}
const {
  label,
  value,
  trend,
  trendDir = 'up',
  accent = false,
  size = 'md',
} = Astro.props;

const trendColor =
  trendDir === 'up'
    ? 'text-emerald-400'
    : trendDir === 'down'
      ? 'text-rose-400'
      : 'text-zinc-400';

const arrow = trendDir === 'up' ? '↑' : trendDir === 'down' ? '↓' : '→';

const valueSizes = {
  sm: 'text-base',
  md: 'text-lg md:text-xl',
};
---

<div
  class={`rounded-xl border p-3 backdrop-blur ${
    accent
      ? 'border-orange-500/30 bg-orange-500/5'
      : 'border-zinc-700/50 bg-zinc-800/60'
  }`}
>
  <p class="text-[9px] uppercase tracking-wider text-zinc-500 font-medium mb-1">
    {label}
  </p>
  <p
    class={`font-semibold leading-none ${valueSizes[size]} ${
      accent ? 'text-orange-400' : 'text-zinc-100'
    }`}
  >
    {value}
  </p>
  {trend && (
    <p class={`text-[10px] mt-1.5 ${trendColor} font-medium`}>
      {arrow} {trend}
    </p>
  )}
</div>
