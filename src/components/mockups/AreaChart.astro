---
interface Props {
  data: number[];
  accent?: string;
  height?: number;
  title?: string;
  caption?: string;
}
const {
  data,
  accent = '#F97316',
  height = 100,
  title,
  caption,
} = Astro.props;

const width = 300;
const max = Math.max(...data, 1);
const min = Math.min(...data, 0);
const range = Math.max(max - min, 1);
const step = width / Math.max(data.length - 1, 1);

const points = data.map((v, i) => {
  const x = i * step;
  const y = height - ((v - min) / range) * height;
  return [x, y] as [number, number];
});

const linePath = points
  .map((p, i) => (i === 0 ? `M ${p[0]} ${p[1]}` : `L ${p[0]} ${p[1]}`))
  .join(' ');

const areaPath = `${linePath} L ${width} ${height} L 0 ${height} Z`;
---

<div class="rounded-xl border border-zinc-700/50 bg-zinc-800/60 p-3 backdrop-blur">
  <div class="flex items-baseline justify-between mb-2">
    {title && (
      <p class="text-[10px] uppercase tracking-wider text-zinc-500 font-medium">
        {title}
      </p>
    )}
    {caption && <p class="text-[10px] text-emerald-400 font-medium">{caption}</p>}
  </div>
  <svg
    viewBox={`0 0 ${width} ${height}`}
    preserveAspectRatio="none"
    class="w-full"
    style={`height:${height * 0.6}px;`}
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color={accent} stop-opacity="0.45" />
        <stop offset="100%" stop-color={accent} stop-opacity="0" />
      </linearGradient>
    </defs>
    <path d={areaPath} fill="url(#areaGrad)" />
    <path
      d={linePath}
      fill="none"
      stroke={accent}
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    {points.map((p) => (
      <circle cx={p[0]} cy={p[1]} r="1.5" fill={accent} />
    ))}
  </svg>
</div>
