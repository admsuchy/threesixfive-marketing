---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import PersonaCard from '../components/PersonaCard.astro';
import FeatureRow from '../components/FeatureRow.astro';

// Icons (inline SVG strings, kept small for tree-shake & dark-bg friendly).
const personaIcons = {
  sales: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  install: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5 12 3l9 6.5"/><path d="M5 9.5V20a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9.5"/><path d="M9 21V12h6v9"/></svg>`,
  ops: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>`,
};

const features = [
  {
    label: 'Earnings',
    title: 'Real-time commissions',
    description:
      'See exactly where every deal stands, what you’ve earned, and what’s pending. No more waiting for payroll to find out.',
  },
  {
    label: 'Field',
    title: 'Install jobs with built-in camera',
    description:
      'Crew leads work install jobs from a single screen — open the job, snap required progress photos with the built-in camera, mark steps complete, hand off to the next stage.',
  },
  {
    label: 'Growth',
    title: 'Team recruiting',
    description:
      'Invite reps with a personal invite link, see who joined from where, and onboard new hires through a guided flow built right into the app.',
  },
  {
    label: 'Operations',
    title: 'A dashboard for every role',
    description:
      'Sales, install, and operations each see the home screen built for their job — with role-based access so the right person sees the right thing.',
  },
  {
    label: 'Goals',
    title: 'Goals and progress tracking',
    description:
      'Set personal sales targets, watch your team’s progress, and stay accountable without micromanagement.',
  },
  {
    label: 'Training',
    title: 'Training Studio',
    description:
      'Push training content, scripts, and SOPs to your team. New reps ramp faster; veterans stay sharp.',
  },
];
---

<Layout
  title="365 — The all-in-one workforce app for residential solar"
  description="365 brings sales reps, crew leads, installers, and operations onto one platform — commissions, jobs, dashboards, payroll, and team recruiting. Built by solar professionals, for residential solar."
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 pointer-events-none">
      <div class="absolute -top-40 -right-20 w-[40rem] h-[40rem] bg-brand-primary/15 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -left-32 w-[30rem] h-[30rem] bg-brand-primary/10 rounded-full blur-3xl"></div>
    </div>

    <div class="container-prose pt-20 md:pt-32 pb-20 md:pb-28">
      <div class="max-w-4xl">
        <p class="badge-pill mb-6 md:mb-10 animate-fade-in">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-primary"></span>
          Built for residential solar
        </p>
        <h1 class="display-xl text-5xl sm:text-6xl md:text-7xl lg:text-8xl mb-6 md:mb-8 animate-fade-up">
          Track commissions.<br />
          Run install jobs.<br />
          <span class="accent-cursive text-brand-primary text-[1.25em]">Grow the team.</span>
        </h1>
        <p class="text-lg md:text-2xl text-brand-muted max-w-2xl leading-snug mb-10 md:mb-12 animate-fade-up" style="animation-delay:80ms">
          365 is the operating system for solar sales teams and install crews —
          commissions, jobs, recruiting, and payroll, all in one app.
        </p>

        <div id="get-the-app" class="flex flex-wrap items-center gap-3 md:gap-4 animate-fade-up" style="animation-delay:160ms">
          <CTAButton href="#get-the-app" variant="primary" size="lg">
            Get on the App Store
          </CTAButton>
          <CTAButton href="#get-the-app" variant="ghost" size="lg">
            Get on Google Play
          </CTAButton>
        </div>
        <p class="mt-4 text-xs uppercase tracking-[0.22em] text-brand-subtle animate-fade-up" style="animation-delay:220ms">
          iOS &amp; Android &middot; Coming soon to the stores
        </p>
      </div>
    </div>
  </section>

  <!-- STATS BAND -->
  <section class="hairline-top hairline-bottom bg-brand-paper/50">
    <div class="container-prose py-10 md:py-14 grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-4">
      <div>
        <div class="display-xl text-4xl md:text-5xl text-brand-ink mb-2">3</div>
        <div class="text-xs uppercase tracking-widest text-brand-subtle">Roles, one app</div>
      </div>
      <div>
        <div class="display-xl text-4xl md:text-5xl text-brand-ink mb-2">6</div>
        <div class="text-xs uppercase tracking-widest text-brand-subtle">States supported</div>
      </div>
      <div>
        <div class="display-xl text-4xl md:text-5xl text-brand-ink mb-2">$0</div>
        <div class="text-xs uppercase tracking-widest text-brand-subtle">To install</div>
      </div>
      <div>
        <div class="display-xl text-4xl md:text-5xl text-brand-ink mb-2">24/7</div>
        <div class="text-xs uppercase tracking-widest text-brand-subtle">Sync across devices</div>
      </div>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="container-prose py-20 md:py-32">
    <div class="max-w-3xl mb-12 md:mb-16">
      <SectionEyebrow label="Who it's for" number="01" />
      <h2 class="text-4xl md:text-5xl lg:text-6xl mb-6 text-brand-ink">
        One app. <span class="accent-cursive text-brand-primary text-[1.15em]">every role.</span>
      </h2>
      <p class="text-base md:text-lg text-brand-muted leading-relaxed">
        365 brings sales, install, and operations onto the same platform —
        each with a home screen designed for their day.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3" id="for-sales">
      <PersonaCard
        role="Sales reps"
        headline="Commissions in real time."
        description="See every deal, every commission, and every recruit on one screen."
        bullets={[
          'Track commissions as deals progress',
          'Set and beat personal sales goals',
          'Invite teammates with a personal link',
        ]}
        icon={personaIcons.sales}
        index={0}
      />
      <div id="for-install" class="contents">
        <PersonaCard
          role="Crew leads & installers"
          headline="Jobs from your pocket."
          description="Open a job, snap required progress photos, mark steps done, hand off."
          bullets={[
            'Built-in camera with required-photo checklists',
            'Job notes, signed documents, and pay details',
            'Push notifications when something changes',
          ]}
          icon={personaIcons.install}
          index={1}
        />
      </div>
      <div id="for-ops" class="contents">
        <PersonaCard
          role="Operations"
          headline="The whole business, at a glance."
          description="Every job, every crew, every blocker — with role-based access baked in."
          bullets={[
            'Top-down dashboards and payroll',
            'Org hierarchy and permissions',
            'Lead management and training studio',
          ]}
          icon={personaIcons.ops}
          index={2}
        />
      </div>
    </div>
  </section>

  <!-- FEATURE GRID -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-32">
      <div class="grid md:grid-cols-[1fr_1.4fr] gap-12 md:gap-20 items-start">
        <div class="md:sticky md:top-28">
          <SectionEyebrow label="What you get" number="02" />
          <h2 class="text-4xl md:text-5xl lg:text-6xl mb-6 text-brand-ink">
            Replace the patchwork
            <span class="accent-cursive text-brand-primary text-[1.15em]">of spreadsheets.</span>
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed max-w-md">
            365 collapses the group chats, clipboard forms, and
            spreadsheet wars most installers run on today.
          </p>
        </div>

        <div class="space-y-px">
          {features.map((f, i) => (
            <FeatureRow label={f.label} title={f.title} description={f.description} index={i} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SCREENSHOTS / PREVIEW PLACEHOLDER -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-32">
      <SectionEyebrow label="On your phone" number="03" />
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
        <h2 class="text-4xl md:text-5xl lg:text-6xl max-w-2xl text-brand-ink">
          A home screen for <span class="accent-cursive text-brand-primary text-[1.15em]">every role.</span>
        </h2>
        <p class="text-sm text-brand-subtle max-w-sm">
          Real product screenshots coming soon. v1 ships with mockups while we
          finalize the App Store assets.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {['Sales dashboard', 'Install job', 'Commissions', 'Operations'].map((label, i) => (
          <div class="aspect-[9/19] rounded-3xl border border-brand-line bg-gradient-to-b from-brand-surface to-brand-paper p-1 shadow-2xl shadow-black/40">
            <div class="h-full rounded-[1.4rem] border border-brand-line bg-brand-paper/80 flex flex-col items-center justify-center p-4 text-center">
              <div class="w-10 h-10 rounded-full bg-brand-primary/15 text-brand-primary flex items-center justify-center mb-3 font-mono text-xs">
                0{i + 1}
              </div>
              <p class="text-xs uppercase tracking-[0.22em] text-brand-muted">
                {label}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MISSION QUOTE -->
  <section class="hairline-top hairline-bottom bg-black/40">
    <div class="container-prose py-24 md:py-36 text-center">
      <p class="text-xs uppercase tracking-[0.22em] text-brand-primary mb-8">Why 365</p>
      <p class="accent-cursive text-4xl md:text-6xl lg:text-7xl leading-tight max-w-4xl mx-auto text-brand-ink">
        Built by solar professionals, for residential solar.
      </p>
      <p class="text-base md:text-lg text-brand-muted leading-relaxed max-w-2xl mx-auto mt-8">
        We sold solar. We managed install crews. We ran the spreadsheets — and
        we built 365 to retire them.
      </p>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="hairline-top">
    <div class="container-prose py-24 md:py-36 text-center">
      <h2 class="text-4xl md:text-6xl lg:text-7xl mb-8 max-w-3xl mx-auto text-brand-ink">
        Ready to <span class="accent-cursive text-brand-primary text-[1.15em]">go pro?</span>
      </h2>
      <p class="text-lg md:text-xl text-brand-muted max-w-xl mx-auto mb-10">
        365 is free to download. Your installer admin invites you in.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4">
        <CTAButton href="#get-the-app" variant="primary" size="lg">
          Get on the App Store
        </CTAButton>
        <CTAButton href="#get-the-app" variant="ghost" size="lg">
          Get on Google Play
        </CTAButton>
      </div>
      <p class="mt-8 text-sm text-brand-subtle">
        Already have an account? <a href="https://threesixfive.app" class="text-brand-primary hover:text-brand-primaryDark underline underline-offset-4">Sign in on the web</a>.
      </p>
    </div>
  </section>
</Layout>
