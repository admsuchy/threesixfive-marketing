---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import MockupFrame from '../components/mockups/MockupFrame.astro';
import KPICard from '../components/mockups/KPICard.astro';
import BarChart from '../components/mockups/BarChart.astro';
import CommissionRow from '../components/mockups/CommissionRow.astro';
import JobCard from '../components/mockups/JobCard.astro';
import PhotoChecklist from '../components/mockups/PhotoChecklist.astro';
import StatusBadge from '../components/mockups/StatusBadge.astro';
import RealScreenshot from '../components/RealScreenshot.astro';

const earningsBars = [
  { label: 'JAN', value: 8 },
  { label: 'FEB', value: 14 },
  { label: 'MAR', value: 11 },
  { label: 'APR', value: 17 },
  { label: 'MAY', value: 22 },
  { label: 'JUN', value: 19 },
];

const highlights = [
  {
    tag: 'Sales',
    title: 'Real-time commissions',
    body: 'Every deal, every dollar, every status — synced the moment it changes.',
    href: '/sales/',
  },
  {
    tag: 'Install',
    title: 'Required-photo checklists',
    body: 'Camera opens right in the job. Photos auto-tagged, reviewed by ops in real time.',
    href: '/install/',
  },
  {
    tag: 'Sales',
    title: 'Team recruiting',
    body: 'Personal invite links, guided onboarding, and conversion analytics.',
    href: '/sales/',
  },
  {
    tag: 'Install',
    title: 'Operations dashboard',
    body: 'Active jobs, payroll, and org hierarchy — all role-aware.',
    href: '/install/',
  },
];
---

<Layout
  title="365 — The all-in-one workforce app for residential solar"
  description="365 brings sales reps, crew leads, installers, and operations onto one platform — commissions, jobs, dashboards, payroll, and team recruiting. Built by solar professionals, for residential solar."
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 pointer-events-none">
      <div class="absolute -top-40 -right-20 w-[40rem] h-[40rem] bg-brand-primary/15 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -left-32 w-[30rem] h-[30rem] bg-brand-primary/10 rounded-full blur-3xl"></div>
    </div>

    <div class="container-prose pt-20 md:pt-32 pb-20 md:pb-28">
      <div class="max-w-4xl">
        <p class="badge-pill mb-6 md:mb-10 animate-fade-in">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-primary"></span>
          Built for residential solar
        </p>
        <h1 class="display-xl text-5xl sm:text-6xl md:text-7xl lg:text-8xl mb-6 md:mb-8 animate-fade-up">
          Track commissions.<br />
          Run install jobs.<br />
          <span class="accent-cursive text-brand-primary text-[1.7em] leading-[1.15] inline-block">Grow the team.</span>
        </h1>
        <p class="text-lg md:text-2xl text-brand-muted max-w-2xl leading-snug mb-10 md:mb-12 animate-fade-up" style="animation-delay:80ms">
          365 is the operating system for solar sales teams and install crews —
          commissions, jobs, recruiting, and payroll, all in one app.
        </p>

        <div id="get-the-app" class="flex flex-wrap items-center gap-3 md:gap-4 animate-fade-up" style="animation-delay:160ms">
          <CTAButton href="https://threesixfive.app" variant="primary" size="lg">
            Open the 365 app
          </CTAButton>
          <CTAButton href="mailto:threesixfive@luminate.solar" variant="ghost" size="lg">
            Ask for an invite
          </CTAButton>
        </div>
        <p class="mt-4 text-xs uppercase tracking-[0.22em] text-brand-subtle animate-fade-up" style="animation-delay:220ms">
          iPhone &amp; Android &middot; Runs right in your browser
        </p>
      </div>
    </div>
  </section>

  <!-- STATS BAND -->
  <section>
    <div class="container-prose pb-16 md:pb-24 grid grid-cols-2 md:grid-cols-4 gap-y-10 gap-x-6">
      <div>
        <div class="display-xl text-3xl md:text-4xl text-brand-ink mb-2">3</div>
        <div class="text-xs uppercase tracking-[0.22em] text-brand-subtle">Roles, one app</div>
      </div>
      <div>
        <div class="display-xl text-3xl md:text-4xl text-brand-ink mb-2">Nationwide</div>
        <div class="text-xs uppercase tracking-[0.22em] text-brand-subtle">Available everywhere</div>
      </div>
      <div>
        <div class="display-xl text-3xl md:text-4xl text-brand-ink mb-2">$0</div>
        <div class="text-xs uppercase tracking-[0.22em] text-brand-subtle">To install</div>
      </div>
      <div>
        <div class="display-xl text-3xl md:text-4xl text-brand-ink mb-2">24/7</div>
        <div class="text-xs uppercase tracking-[0.22em] text-brand-subtle">Sync across devices</div>
      </div>
    </div>
  </section>

  <!-- 4-FEATURE HIGHLIGHT STRIP -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="max-w-3xl mb-12 md:mb-16">
        <SectionEyebrow label="What you get" number="01" />
        <h2 class="text-4xl md:text-5xl lg:text-6xl text-brand-ink">
          Replace the patchwork <span class="accent-cursive text-brand-primary text-[1.5em]">of spreadsheets.</span>
        </h2>
      </div>

      <div class="grid gap-px bg-brand-line rounded-2xl overflow-hidden md:grid-cols-4 border border-brand-line">
        {highlights.map((h) => (
          <a
            href={h.href}
            class="group bg-brand-surface/60 hover:bg-brand-surface p-6 md:p-7 transition-colors flex flex-col"
          >
            <p class="text-[10px] uppercase tracking-[0.22em] text-brand-primary font-medium mb-4">{h.tag}</p>
            <h3 class="text-xl md:text-2xl mb-3 text-brand-ink group-hover:text-brand-primary transition-colors leading-snug">
              {h.title}
            </h3>
            <p class="text-sm text-brand-muted leading-relaxed mb-4">{h.body}</p>
            <p class="mt-auto text-xs font-medium text-brand-subtle group-hover:text-brand-primary transition-colors">
              {h.tag === 'Sales' ? 'See on /sales' : 'See on /install'} &rarr;
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MOCKUP TEASER STRIP -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
        <div class="max-w-2xl">
          <SectionEyebrow label="On your phone" number="02" />
          <h2 class="text-4xl md:text-5xl lg:text-6xl text-brand-ink">
            A home screen for <span class="accent-cursive text-brand-primary text-[1.5em]">every role.</span>
          </h2>
        </div>
      </div>

      <div class="grid gap-10 md:gap-14 md:grid-cols-2 items-start">
        <div>
          <RealScreenshot
            src="/screenshots/sales-commissions.png"
            alt="365 commissions — real-time deal-by-deal earnings."
            size="md"
          />
          <p class="mt-6 text-center text-sm text-brand-muted">
            Sales reps see commissions in real time.
          </p>
        </div>
        <div>
          <RealScreenshot
            src="/screenshots/ops-sitecam-feed.png"
            alt="SiteCam — the whole company's install photos, searchable by customer or address."
            size="md"
          />
          <p class="mt-6 text-center text-sm text-brand-muted">
            SiteCam: every install photo the company has ever taken, searchable.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- MISSION QUOTE -->
  <section class="hairline-top hairline-bottom bg-black/40">
    <div class="container-prose py-24 md:py-36 text-center">
      <p class="text-xs uppercase tracking-[0.22em] text-brand-primary mb-8">Why 365</p>
      <p class="accent-cursive text-4xl md:text-6xl lg:text-7xl leading-tight max-w-4xl mx-auto text-brand-ink">
        Built by solar professionals, for residential solar.
      </p>
      <p class="text-base md:text-lg text-brand-muted leading-relaxed max-w-2xl mx-auto mt-8">
        We sold solar. We managed install crews. We ran the spreadsheets — and
        we built 365 to retire them.
      </p>
    </div>
  </section>

  <!-- TWO BIG PERSONA CARDS -->
  <section class="hairline-top container-prose py-20 md:py-28">
    <div class="max-w-3xl mb-12 md:mb-16">
      <SectionEyebrow label="Who it's for" number="03" />
      <h2 class="text-4xl md:text-5xl lg:text-6xl mb-6 text-brand-ink">
        Pick your <span class="accent-cursive text-brand-primary text-[1.5em]">side of the team.</span>
      </h2>
      <p class="text-base md:text-lg text-brand-muted leading-relaxed">
        Two home screens. One platform. Each role gets the app built for
        their day — and dives deeper from here.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <!-- For Sales -->
      <div class="group relative p-6 md:p-8 border border-brand-line rounded-3xl bg-brand-surface/60 hover:border-brand-primary/60 transition-all duration-300 flex flex-col">
        <div class="flex items-start justify-between mb-6">
          <p class="text-xs uppercase tracking-[0.22em] text-brand-primary font-medium">For Sales</p>
          <span class="text-xs font-mono text-brand-subtle tabular-nums">01</span>
        </div>
        <h3 class="text-3xl md:text-4xl mb-3 text-brand-ink">
          Track every commission. <span class="accent-cursive text-brand-primary text-[1.5em]">Beat every goal.</span>
        </h3>
        <ul class="mt-2 mb-6 space-y-2 text-sm text-brand-muted">
          <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Real-time commission tracking on every deal</span></li>
          <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Adaptive goals that update as deals close</span></li>
          <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Personal invite links + onboarding for new reps</span></li>
        </ul>

        <div class="mt-auto pt-2">
          <div class="rounded-2xl border border-brand-line bg-brand-paper/60 p-4">
            <MockupFrame title="Commissions" subtitle="June 2026" size="sm" showBattery={false}>
              <div class="grid grid-cols-2 gap-1.5">
                <KPICard label="Month" value="$12.4k" trend="24%" accent size="sm" />
                <KPICard label="Lifetime" value="$184k" size="sm" />
              </div>
              <div class="space-y-1.5">
                <CommissionRow customer="Hernandez, J." amount="$4,225" status="paid" />
                <CommissionRow customer="Patel, R." amount="$3,100" status="pending" />
              </div>
            </MockupFrame>
            <p class="mt-3 text-center text-[10px] uppercase tracking-[0.18em] text-brand-subtle">
              Sales · Live commissions
            </p>
          </div>
          <a
            href="/sales/"
            class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-brand-primary hover:underline underline-offset-4"
          >
            Explore for sales &rarr;
          </a>
        </div>
      </div>

      <!-- For Install -->
      <div class="group relative p-6 md:p-8 border border-brand-line rounded-3xl bg-brand-surface/60 hover:border-brand-primary/60 transition-all duration-300 flex flex-col">
        <div class="flex items-start justify-between mb-6">
          <p class="text-xs uppercase tracking-[0.22em] text-brand-primary font-medium">For Install &amp; Ops</p>
          <span class="text-xs font-mono text-brand-subtle tabular-nums">02</span>
        </div>
        <h3 class="text-3xl md:text-4xl mb-3 text-brand-ink">
          Run the field. <span class="accent-cursive text-brand-primary text-[1.5em]">Own the business.</span>
        </h3>
        <ul class="mt-2 mb-6 space-y-2 text-sm text-brand-muted">
          <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Transparent crew pay — every week, every dollar</span></li>
          <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Live ops dashboard for the whole field at a glance</span></li>
          <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Required-photo checklists + payroll, no spreadsheets</span></li>
        </ul>

        <div class="mt-auto pt-2">
          <div class="rounded-2xl border border-brand-line bg-brand-paper/60 p-4 install-carousel" data-install-carousel>
            <div class="overflow-hidden">
              <div class="flex transition-transform duration-500 ease-out" data-carousel-track>
                <!-- Slide 1: Pay you can see -->
                <div class="w-full flex-shrink-0">
                  <MockupFrame title="My Pay" subtitle="June · By Week" size="sm" showBattery={false}>
                    <div class="grid grid-cols-2 gap-1 rounded-lg bg-zinc-900/60 border border-zinc-700/50 p-0.5">
                      <button type="button" class="rounded-md bg-orange-500 text-black text-[10px] font-semibold py-1 pointer-events-none">By Week</button>
                      <button type="button" class="rounded-md text-zinc-400 text-[10px] font-medium py-1 pointer-events-none">By Job</button>
                    </div>
                    <div class="space-y-1.5">
                      <div class="flex items-center justify-between rounded-lg border border-zinc-700/50 bg-zinc-800/60 px-2.5 py-1.5">
                        <div>
                          <p class="text-[11px] font-semibold text-zinc-100 leading-tight">Wk 23 &middot; Jun 1–7</p>
                          <p class="text-[9px] text-zinc-500">4 jobs · 12 lines</p>
                        </div>
                        <div class="text-right">
                          <p class="text-[12px] font-semibold text-orange-400 font-mono tabular-nums leading-none">$1,840</p>
                          <div class="mt-1"><StatusBadge label="Paid" tone="paid" /></div>
                        </div>
                      </div>
                      <div class="flex items-center justify-between rounded-lg border border-zinc-700/50 bg-zinc-800/60 px-2.5 py-1.5">
                        <div>
                          <p class="text-[11px] font-semibold text-zinc-100 leading-tight">Wk 24 &middot; Jun 8–14</p>
                          <p class="text-[9px] text-zinc-500">3 jobs · 9 lines</p>
                        </div>
                        <div class="text-right">
                          <p class="text-[12px] font-semibold text-orange-400 font-mono tabular-nums leading-none">$1,520</p>
                          <div class="mt-1"><StatusBadge label="Paid" tone="paid" /></div>
                        </div>
                      </div>
                      <div class="flex items-center justify-between rounded-lg border border-orange-500/30 bg-orange-500/5 px-2.5 py-1.5">
                        <div>
                          <p class="text-[11px] font-semibold text-zinc-100 leading-tight">Wk 25 &middot; Jun 15–21</p>
                          <p class="text-[9px] text-zinc-500">2 jobs · 6 lines</p>
                        </div>
                        <div class="text-right">
                          <p class="text-[12px] font-semibold text-orange-400 font-mono tabular-nums leading-none">$1,460</p>
                          <div class="mt-1"><StatusBadge label="Open" tone="open" /></div>
                        </div>
                      </div>
                    </div>
                  </MockupFrame>
                </div>

                <!-- Slide 2: Ops dashboard -->
                <div class="w-full flex-shrink-0">
                  <MockupFrame title="Operations" subtitle="Phoenix · Live" size="sm" showBattery={false}>
                    <div class="grid grid-cols-3 gap-1.5">
                      <KPICard label="Active" value="27" accent size="sm" />
                      <KPICard label="Photos" value="8" trendDir="down" trend="↓ 3" size="sm" />
                      <KPICard label="Paid wk" value="$54k" size="sm" />
                    </div>
                    <div class="space-y-1.5">
                      <JobCard customer="Reyes, A." address="Mesa, AZ" systemKw="10.5 kW" status="review" statusLabel="Review" photosDone={8} photosTotal={8} />
                      <JobCard customer="Walker, T." address="Gilbert, AZ" systemKw="11.2 kW" status="photos" photosDone={5} photosTotal={9} />
                      <JobCard customer="Diaz, L." address="Chandler, AZ" systemKw="8.8 kW" status="open" photosDone={0} photosTotal={8} />
                    </div>
                  </MockupFrame>
                </div>
              </div>
            </div>

            <!-- Dots + label -->
            <div class="flex items-center justify-center gap-2 mt-4" data-carousel-dots>
              <button type="button" aria-label="Slide 1: Crew pay" data-slide="0" class="h-1 w-8 rounded-full bg-brand-primary transition-colors"></button>
              <button type="button" aria-label="Slide 2: Operations dashboard" data-slide="1" class="h-1 w-8 rounded-full bg-brand-line hover:bg-brand-subtle transition-colors"></button>
            </div>
            <p class="mt-2 text-center text-[10px] uppercase tracking-[0.18em] text-brand-subtle" data-carousel-label>
              Owner · Crew pay
            </p>
          </div>
          <a
            href="/install/"
            class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-brand-primary hover:underline underline-offset-4"
          >
            Explore for install &amp; ops &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="hairline-top">
    <div class="container-prose py-24 md:py-36 text-center">
      <h2 class="text-4xl md:text-6xl lg:text-7xl mb-8 max-w-3xl mx-auto text-brand-ink">
        Ready to <span class="accent-cursive text-brand-primary text-[1.5em]">go pro?</span>
      </h2>
      <p class="text-lg md:text-xl text-brand-muted max-w-xl mx-auto mb-10">
        365 runs on any phone, right in the browser. Your installer admin invites you in.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4">
        <CTAButton href="https://threesixfive.app" variant="primary" size="lg">
          Open the 365 app
        </CTAButton>
        <CTAButton href="mailto:threesixfive@luminate.solar" variant="ghost" size="lg">
          Ask for an invite
        </CTAButton>
      </div>
      <p class="mt-8 text-sm text-brand-subtle">
        Already have an account? <a href="https://threesixfive.app" class="text-brand-primary hover:text-brand-primaryDark underline underline-offset-4">Sign in on the web</a>.
      </p>
    </div>
  </section>
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('[data-install-carousel]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-slide]'));
    const label = root.querySelector<HTMLElement>('[data-carousel-label]');
    const labels = ['Owner · Crew pay', 'Ops · Live dashboard'];
    const slideCount = dots.length;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    function render() {
      if (track) track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => {
        const active = i === current;
        d.classList.toggle('bg-brand-primary', active);
        d.classList.toggle('bg-brand-line', !active);
      });
      if (label) label.textContent = labels[current];
    }

    function go(i: number) {
      current = (i + slideCount) % slideCount;
      render();
    }

    function startTimer() {
      stopTimer();
      timer = setInterval(() => go(current + 1), 5500);
    }

    function stopTimer() {
      if (timer) clearInterval(timer);
      timer = undefined;
    }

    dots.forEach((d) => {
      d.addEventListener('click', (e) => {
        e.preventDefault();
        const i = Number(d.dataset.slide ?? 0);
        go(i);
        startTimer();
      });
    });

    root.addEventListener('mouseenter', stopTimer);
    root.addEventListener('mouseleave', startTimer);

    render();
    startTimer();
  }
</script>
