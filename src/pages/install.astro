---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import MockupSection from '../components/mockups/MockupSection.astro';
import RealScreenshot from '../components/RealScreenshot.astro';
---

<Layout
  title="365 for Install & Ops — Run install jobs. Lead the field. Pay the team."
  description="365 puts every install job in your pocket — required-photo checklists, native camera, instant pay visibility, and operations-grade dashboards for crew leads, installers, and ops officers."
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 pointer-events-none">
      <div class="absolute -top-40 -right-20 w-[40rem] h-[40rem] bg-brand-primary/20 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -left-32 w-[30rem] h-[30rem] bg-brand-primary/10 rounded-full blur-3xl"></div>
    </div>

    <div class="container-prose pt-20 md:pt-28 pb-16 md:pb-20">
      <div class="grid md:grid-cols-[1.2fr_1fr] gap-12 md:gap-16 items-center">
        <div>
          <p class="text-xs uppercase tracking-[0.22em] text-brand-primary font-medium mb-4 animate-fade-in">
            02 · For Install &amp; Ops
          </p>
          <h1 class="display-xl text-5xl sm:text-6xl md:text-7xl lg:text-[5rem] mb-6 md:mb-8 animate-fade-up">
            Run install jobs.<br />
            Lead the field.<br />
            <span class="accent-cursive text-brand-primary text-[1.25em]">Pay the team.</span>
          </h1>
          <p class="text-lg md:text-xl text-brand-muted max-w-xl leading-snug mb-10 animate-fade-up" style="animation-delay:80ms">
            365 hands every crew lead, installer, and ops officer a screen
            built for their day. Open the job. Snap the photos. Mark steps
            complete. Move on.
          </p>

          <div id="get-the-app" class="flex flex-wrap items-center gap-3 md:gap-4 animate-fade-up" style="animation-delay:160ms">
            <CTAButton href="https://threesixfive.app" variant="primary" size="lg">
              Open the 365 app
            </CTAButton>
            <CTAButton href="mailto:threesixfive@luminate.solar" variant="ghost" size="lg">
              Ask for an invite
            </CTAButton>
          </div>
          <p class="mt-4 text-xs uppercase tracking-[0.22em] text-brand-subtle animate-fade-up" style="animation-delay:220ms">
            iPhone &amp; Android &middot; Camera built into every job
          </p>
        </div>

        <div class="hidden md:block animate-fade-up" style="animation-delay:120ms">
          <RealScreenshot
            src="/screenshots/install-job-detail.png"
            alt="365 install job detail — Hernandez, Jane in Phoenix, AZ with photo checklist and crew pay."
            size="md"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- HERO MOCKUP CAPTION (mobile only) -->
  <section class="md:hidden container-prose pb-12">
    <RealScreenshot
      src="/screenshots/install-job-detail.png"
      alt="365 install job detail — Hernandez."
      size="sm"
    />
    <p class="mt-6 text-center text-sm text-brand-muted">
      Open a job, snap required photos, mark steps done, hand off.
    </p>
  </section>

  <!-- FEATURE: JOBS FROM YOUR POCKET -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <div>
          <SectionEyebrow label="Jobs from your pocket" number="02" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            Every job,
            <span class="accent-cursive text-brand-primary text-[1.5em]">one screen,</span>
            zero clipboard.
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            Your jobs for the week show up the moment they're assigned.
            Each card knows where you are in the process — open, photos
            in progress, in review, paid — and what's blocking the next
            step. No more "let me check with the office."
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Status pills update live as office reviews come back</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Address, system size, crew, schedule — all on the card</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Push notifications the second a job changes</span></li>
          </ul>
        </div>
        <MockupSection caption="The week, as a stack of cards.">
          <RealScreenshot
            src="/screenshots/install-jobs-list.png"
            alt="365 install jobs list — six AZ jobs with mixed status badges."
            size="md"
          />
        </MockupSection>
      </div>
    </div>
  </section>

  <!-- FEATURE: REQUIRED-PHOTO CHECKLISTS -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <MockupSection class="md:order-1 order-2" caption="Camera opens inside the job. Photos checked off the second they're taken.">
          <RealScreenshot
            src="/screenshots/install-qc-checklist.png"
            alt="365 QC checklist — sections with progress, camera per item, and example reference shots."
            size="md"
          />
        </MockupSection>
        <div class="md:order-2 order-1">
          <SectionEyebrow label="Required-photo checklists" number="03" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            The photos that
            <span class="accent-cursive text-brand-primary text-[1.5em]">unlock pay.</span>
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            Every job tells the crew exactly which photos are required and
            which are still missing. The native camera opens right inside
            the job — no app-switching, no AirDrop, no lost shots. Once
            the checklist is green, the office gets pinged automatically.
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Example reference shots on every checklist item — crews see what right looks like</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Photos auto-tagged with job, GPS, and timestamp</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Office sees the gallery the moment a photo uploads</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE: NOTIFICATIONS / STAY IN SYNC -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <div>
          <SectionEyebrow label="Pay you can see" number="04" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            Every dollar,
            <span class="accent-cursive text-brand-primary text-[1.5em]">accounted for.</span>
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            The second a commission posts, a payroll period locks, or a
            crew member's job changes hands — 365 tells the whole team.
            Pay updates, job assignments, and photo reviews arrive as
            push notifications, so nobody's chasing the office for status.
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Commission paid, payroll locked, photos submitted — all pushed</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Read / unread filters so the bell stays meaningful</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Tap any item to jump straight to the underlying job or pay run</span></li>
          </ul>
        </div>
        <MockupSection caption="Five updates this week. Three unread.">
          <RealScreenshot
            src="/screenshots/install-notifications.png"
            alt="365 notifications inbox — pay, payroll, and job notifications with unread badges."
            size="md"
          />
        </MockupSection>
      </div>
    </div>
  </section>

  <!-- OPERATIONS DIVIDER -->
  <section class="hairline-top">
    <div class="container-prose py-12 md:py-16">
      <div class="flex items-center gap-4">
        <span class="h-px flex-1 bg-brand-line"></span>
        <span class="text-xs uppercase tracking-[0.28em] text-brand-primary font-medium">Operations</span>
        <span class="h-px flex-1 bg-brand-line"></span>
      </div>
      <p class="mt-6 text-center text-base md:text-lg text-brand-muted max-w-2xl mx-auto leading-relaxed">
        For the ops officers, project managers, and owners who keep the
        whole field running.
      </p>
    </div>
  </section>

  <!-- FEATURE: OPS DASHBOARD -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <div>
          <SectionEyebrow label="A dashboard for ops officers" number="05" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            The whole business,
            <span class="accent-cursive text-brand-primary text-[1.5em]">at a glance.</span>
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            Active jobs, photos awaiting review, payroll loaded, lead pipeline.
            Every metric an ops officer needs on a single screen — with role
            and org-hierarchy-based access so the right person sees the right
            thing.
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Org hierarchy: company &rarr; team &rarr; crew &rarr; installer</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Role-based access: ops, admin, crew lead, installer, sales</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Drill into any job, photo, or pay entry in one tap</span></li>
          </ul>
        </div>
        <MockupSection caption="Tuesday morning standup, in one screen.">
          <RealScreenshot
            src="/screenshots/install-ops-dashboard.png"
            alt="365 operations dashboard — Crew Leads, Open Jobs, Awaiting Review, Total Paid."
            size="md"
          />
        </MockupSection>
      </div>
    </div>
  </section>


  <!-- FEATURE: SITECAM -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <MockupSection class="md:order-1 order-2" caption="Every photo the company has ever taken. One search away.">
          <RealScreenshot
            src="/screenshots/ops-sitecam-feed.png"
            alt="SiteCam photo feed — thousands of install photos, filterable by job, person, and category."
            size="md"
          />
        </MockupSection>
        <div class="md:order-2 order-1">
          <SectionEyebrow label="SiteCam — the photo hub" number="06" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            Your whole install history,
            <span class="accent-cursive text-brand-primary text-[1.5em]">searchable.</span>
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            SiteCam is the company photo feed: every shot from every crew,
            organized by job, dated, and tagged with who took it. Search a
            customer or an address and jump straight to their install.
            Select any set of photos and export a client-ready PDF.
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Search by customer or address — the feed jumps to that job</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>QC checklists and reference-shot manager, one tab away</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Select photos &rarr; export a branded PDF report</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE: CREW MANAGEMENT -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <div>
          <SectionEyebrow label="Crews &amp; pay, per job" number="07" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            Staff the job,
            <span class="accent-cursive text-brand-primary text-[1.5em]">set the pay,</span>
            move on.
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            Add crew to a job, mark the lead, and set per-kW pay right on
            the job page. Everyone assigned sees the job in their own list
            with tap-to-navigate directions. Once someone's been paid,
            their row locks — no accidental repricing after the fact.
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Add / remove crew and set primary in one dialog</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Tap the address &rarr; straight into Maps</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Paid rows lock automatically, with a full audit trail</span></li>
          </ul>
        </div>
        <MockupSection caption="One job page: status, crew, pay, photos, history.">
          <RealScreenshot
            src="/screenshots/ops-crew-management.png"
            alt="365 job page — status, installers with per-kW pay, service and pay history."
            size="md"
          />
        </MockupSection>
      </div>
    </div>
  </section>

  <!-- FEATURE: PAYROLL WITHOUT SPREADSHEETS -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <MockupSection class="md:order-1 order-2" caption="Lock the week. Pay the team. Done.">
          <RealScreenshot
            src="/screenshots/install-payroll.png"
            alt="365 payroll — three weeks with locked + open status and crew totals."
            size="md"
          />
        </MockupSection>
        <div class="md:order-2 order-1">
          <SectionEyebrow label="Payroll without spreadsheets" number="08" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            Retire
            <span class="accent-cursive text-brand-primary text-[1.5em]">the spreadsheet</span>
            for good.
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            Pay rules live in 365, not in your head. Open the week, review
            the line items, lock it, and pay. Adjustments, deductions, and
            bonuses ride along — and the whole crew sees their pay the
            moment the week closes.
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Week-grouped pay with locked / unlocked statuses</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Audit trail on every adjustment</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Export to QuickBooks, Gusto, or CSV</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CROSS-LINK -->
  <section class="hairline-top hairline-bottom bg-brand-paper/40">
    <div class="container-prose py-10 md:py-14 text-center">
      <p class="text-sm md:text-base text-brand-muted">
        Sell solar too?
        <a href="/sales/" class="text-brand-primary hover:text-brand-primaryDark underline underline-offset-4 ml-1">
          See 365 for sales reps &rarr;
        </a>
      </p>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="hairline-top">
    <div class="container-prose py-24 md:py-32 text-center">
      <h2 class="text-4xl md:text-6xl lg:text-7xl mb-8 max-w-3xl mx-auto text-brand-ink">
        Ready to <span class="accent-cursive text-brand-primary text-[1.5em]">run the field?</span>
      </h2>
      <p class="text-lg md:text-xl text-brand-muted max-w-xl mx-auto mb-10">
        365 runs on any phone, right in the browser. Your ops admin invites you in.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4">
        <CTAButton href="https://threesixfive.app" variant="primary" size="lg">
          Open the 365 app
        </CTAButton>
        <CTAButton href="mailto:threesixfive@luminate.solar" variant="ghost" size="lg">
          Ask for an invite
        </CTAButton>
      </div>
      <p class="mt-8 text-sm text-brand-subtle">
        Already on 365? <a href="https://threesixfive.app" class="text-brand-primary hover:text-brand-primaryDark underline underline-offset-4">Sign in on the web</a>.
      </p>
    </div>
  </section>
</Layout>
