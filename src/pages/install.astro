---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import MockupFrame from '../components/mockups/MockupFrame.astro';
import MockupSection from '../components/mockups/MockupSection.astro';
import KPICard from '../components/mockups/KPICard.astro';
import BarChart from '../components/mockups/BarChart.astro';
import JobCard from '../components/mockups/JobCard.astro';
import PhotoChecklist from '../components/mockups/PhotoChecklist.astro';
import CommissionRow from '../components/mockups/CommissionRow.astro';
import StatusBadge from '../components/mockups/StatusBadge.astro';

const photoItems = [
  { label: 'Roof before', done: true },
  { label: 'Attic before', done: true },
  { label: 'Main panel', done: true },
  { label: 'Mount layout', done: true },
  { label: 'Module install', done: false },
  { label: 'Inverter', done: false },
];

const jobsBar = [
  { label: 'MON', value: 4 },
  { label: 'TUE', value: 6 },
  { label: 'WED', value: 3 },
  { label: 'THU', value: 7 },
  { label: 'FRI', value: 5 },
  { label: 'SAT', value: 2 },
];
---

<Layout
  title="365 for Install & Ops — Run install jobs. Lead the field. Pay the team."
  description="365 puts every install job in your pocket — required-photo checklists, native camera, instant pay visibility, and operations-grade dashboards for crew leads, installers, and ops officers."
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 pointer-events-none">
      <div class="absolute -top-40 -right-20 w-[40rem] h-[40rem] bg-brand-primary/20 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -left-32 w-[30rem] h-[30rem] bg-brand-primary/10 rounded-full blur-3xl"></div>
    </div>

    <div class="container-prose pt-20 md:pt-28 pb-16 md:pb-20">
      <div class="grid md:grid-cols-[1.2fr_1fr] gap-12 md:gap-16 items-center">
        <div>
          <p class="text-xs uppercase tracking-[0.22em] text-brand-primary font-medium mb-4 animate-fade-in">
            02 · For Install &amp; Ops
          </p>
          <h1 class="display-xl text-5xl sm:text-6xl md:text-7xl lg:text-[5rem] mb-6 md:mb-8 animate-fade-up">
            Run install jobs.<br />
            Lead the field.<br />
            <span class="accent-cursive text-brand-primary text-[1.25em]">Pay the team.</span>
          </h1>
          <p class="text-lg md:text-xl text-brand-muted max-w-xl leading-snug mb-10 animate-fade-up" style="animation-delay:80ms">
            365 hands every crew lead, installer, and ops officer a screen
            built for their day. Open the job. Snap the photos. Mark steps
            complete. Move on.
          </p>

          <div id="get-the-app" class="flex flex-wrap items-center gap-3 md:gap-4 animate-fade-up" style="animation-delay:160ms">
            <CTAButton href="#get-the-app" variant="primary" size="lg">
              Get on the App Store
            </CTAButton>
            <CTAButton href="#get-the-app" variant="ghost" size="lg">
              Get on Google Play
            </CTAButton>
          </div>
          <p class="mt-4 text-xs uppercase tracking-[0.22em] text-brand-subtle animate-fade-up" style="animation-delay:220ms">
            iOS &amp; Android &middot; Native camera, built-in
          </p>
        </div>

        <div class="hidden md:block animate-fade-up" style="animation-delay:120ms">
          <MockupFrame title="Job · Hernandez" subtitle="8.45 kW · Phoenix, AZ" size="md">
            <div class="flex items-center justify-between rounded-lg bg-zinc-800/60 border border-zinc-700/50 px-3 py-2">
              <div>
                <p class="text-[10px] uppercase tracking-wider text-zinc-500">Job status</p>
                <p class="text-[12px] font-semibold text-zinc-100">Photos in progress</p>
              </div>
              <StatusBadge label="Photos" tone="photos" size="sm" />
            </div>
            <PhotoChecklist title="Required photos" items={photoItems} columns={3} />
            <div class="space-y-1.5">
              <CommissionRow customer="Pre-wire pay" amount="$320" status="paid" statusLabel="Logged" />
              <CommissionRow customer="Install day pay" amount="$650" status="pending" statusLabel="Pending" />
            </div>
          </MockupFrame>
        </div>
      </div>
    </div>
  </section>

  <!-- HERO MOCKUP CAPTION (mobile only) -->
  <section class="md:hidden container-prose pb-12">
    <MockupFrame title="Job · Hernandez" subtitle="8.45 kW · Phoenix" size="sm">
      <PhotoChecklist title="Required photos" items={photoItems} columns={3} />
    </MockupFrame>
    <p class="mt-6 text-center text-sm text-brand-muted">
      Open a job, snap required photos, mark steps done, hand off.
    </p>
  </section>

  <!-- FEATURE: JOBS FROM YOUR POCKET -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <div>
          <SectionEyebrow label="Jobs from your pocket" number="02" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            Every job,
            <span class="accent-cursive text-brand-primary text-[1.15em]">one screen,</span>
            zero clipboard.
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            Your jobs for the week show up the moment they're assigned.
            Each card knows where you are in the process — open, photos
            in progress, in review, paid — and what's blocking the next
            step. No more "let me check with the office."
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Status pills update live as office reviews come back</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Address, system size, crew, schedule — all on the card</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Push notifications the second a job changes</span></li>
          </ul>
        </div>
        <MockupSection caption="The week, as a stack of cards.">
          <MockupFrame title="My Jobs" subtitle="This week · 5 active" size="md">
            <div class="space-y-2">
              <JobCard customer="Hernandez, Jane" address="3141 Camelback Rd, Phoenix" systemKw="8.45 kW" status="photos" photosDone={4} photosTotal={6} />
              <JobCard customer="Patel, Rohan" address="847 Acacia Ln, Tempe" systemKw="6.20 kW" status="open" photosDone={0} photosTotal={8} />
              <JobCard customer="Nguyen, Lin" address="22 Sunset Dr, Mesa" systemKw="9.80 kW" status="review" statusLabel="In Review" photosDone={8} photosTotal={8} />
              <JobCard customer="Brooks, Mike" address="105 Maple St, Chandler" systemKw="7.15 kW" status="paid" photosDone={8} photosTotal={8} />
            </div>
          </MockupFrame>
        </MockupSection>
      </div>
    </div>
  </section>

  <!-- FEATURE: REQUIRED-PHOTO CHECKLISTS -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <MockupSection class="md:order-1 order-2" caption="Native iOS &amp; Android camera. Photos checked off the second they're taken.">
          <MockupFrame title="Photo Checklist" subtitle="Hernandez · 4 of 6" size="md">
            <PhotoChecklist
              title="Pre-install"
              items={[
                { label: 'Roof before', done: true },
                { label: 'Attic before', done: true },
                { label: 'Main panel', done: true },
              ]}
              columns={3}
            />
            <PhotoChecklist
              title="Install day"
              items={[
                { label: 'Mount layout', done: true },
                { label: 'Module install', done: false },
                { label: 'Inverter', done: false },
              ]}
              columns={3}
            />
          </MockupFrame>
        </MockupSection>
        <div class="md:order-2 order-1">
          <SectionEyebrow label="Required-photo checklists" number="03" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            The photos that
            <span class="accent-cursive text-brand-primary text-[1.15em]">unlock pay.</span>
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            Every job tells the crew exactly which photos are required and
            which are still missing. The native camera opens right inside
            the job — no app-switching, no AirDrop, no lost shots. Once
            the checklist is green, the office gets pinged automatically.
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Native camera via Capacitor — works offline, syncs later</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Photos auto-tagged with job, GPS, and timestamp</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Office sees the gallery the moment a photo uploads</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE: PAY YOU CAN SEE -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <div>
          <SectionEyebrow label="Pay you can see" number="04" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            Every dollar,
            <span class="accent-cursive text-brand-primary text-[1.15em]">accounted for.</span>
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            Toggle between "By Job" and "By Week." See exactly which jobs
            paid out, which are pending, and which week is still open for
            edits. No more chasing the office for an explanation.
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>By Job &middot; By Week toggle with running totals</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Locked / unlocked week badges so you know what's final</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Tap any line to see the pay rule that fired</span></li>
          </ul>
        </div>
        <MockupSection caption="Crew pay, on the same screen the office runs payroll from.">
          <MockupFrame title="My Pay" subtitle="June · $4,820 paid" size="md">
            <div class="grid grid-cols-2 gap-1 rounded-lg bg-zinc-900/60 border border-zinc-700/50 p-1">
              <button class="rounded-md bg-orange-500 text-black text-[11px] font-semibold py-1.5">By Week</button>
              <button class="rounded-md text-zinc-400 text-[11px] font-medium py-1.5">By Job</button>
            </div>
            <div class="space-y-1.5">
              <div class="flex items-center justify-between rounded-lg border border-zinc-700/50 bg-zinc-800/60 px-3 py-2">
                <div>
                  <p class="text-[11px] font-semibold text-zinc-100">Wk 23 &middot; Jun 1–7</p>
                  <p class="text-[10px] text-zinc-500">4 jobs · 12 line items</p>
                </div>
                <div class="text-right">
                  <p class="text-[13px] font-semibold text-orange-400 font-mono tabular-nums">$1,840</p>
                  <StatusBadge label="Paid" tone="paid" />
                </div>
              </div>
              <div class="flex items-center justify-between rounded-lg border border-zinc-700/50 bg-zinc-800/60 px-3 py-2">
                <div>
                  <p class="text-[11px] font-semibold text-zinc-100">Wk 24 &middot; Jun 8–14</p>
                  <p class="text-[10px] text-zinc-500">3 jobs · 9 line items</p>
                </div>
                <div class="text-right">
                  <p class="text-[13px] font-semibold text-orange-400 font-mono tabular-nums">$1,520</p>
                  <StatusBadge label="Paid" tone="paid" />
                </div>
              </div>
              <div class="flex items-center justify-between rounded-lg border border-orange-500/30 bg-orange-500/5 px-3 py-2">
                <div>
                  <p class="text-[11px] font-semibold text-zinc-100">Wk 25 &middot; Jun 15–21</p>
                  <p class="text-[10px] text-zinc-500">2 jobs · 6 line items</p>
                </div>
                <div class="text-right">
                  <p class="text-[13px] font-semibold text-orange-400 font-mono tabular-nums">$1,460</p>
                  <StatusBadge label="Open" tone="open" />
                </div>
              </div>
            </div>
          </MockupFrame>
        </MockupSection>
      </div>
    </div>
  </section>

  <!-- OPERATIONS DIVIDER -->
  <section class="hairline-top">
    <div class="container-prose py-12 md:py-16">
      <div class="flex items-center gap-4">
        <span class="h-px flex-1 bg-brand-line"></span>
        <span class="text-xs uppercase tracking-[0.28em] text-brand-primary font-medium">Operations</span>
        <span class="h-px flex-1 bg-brand-line"></span>
      </div>
      <p class="mt-6 text-center text-base md:text-lg text-brand-muted max-w-2xl mx-auto leading-relaxed">
        For the ops officers, project managers, and owners who keep the
        whole field running.
      </p>
    </div>
  </section>

  <!-- FEATURE: OPS DASHBOARD -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <div>
          <SectionEyebrow label="A dashboard for ops officers" number="05" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            The whole business,
            <span class="accent-cursive text-brand-primary text-[1.15em]">at a glance.</span>
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            Active jobs, photos awaiting review, payroll loaded, lead pipeline.
            Every metric an ops officer needs on a single screen — with role
            and org-hierarchy-based access so the right person sees the right
            thing.
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Org hierarchy: company &rarr; team &rarr; crew &rarr; installer</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Role-based access: ops, admin, crew lead, installer, sales</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Drill into any job, photo, or pay entry in one tap</span></li>
          </ul>
        </div>
        <MockupSection caption="Tuesday morning standup, in one screen.">
          <MockupFrame title="Operations" subtitle="Phoenix · This week" size="md">
            <div class="grid grid-cols-3 gap-2">
              <KPICard label="Active jobs" value="27" accent />
              <KPICard label="Awaiting photos" value="8" trendDir="down" trend="↓ 3" />
              <KPICard label="Paid this wk" value="$54k" trend="↑ 12%" />
            </div>
            <BarChart data={jobsBar} title="Jobs completed · last 6 days" />
            <div class="space-y-1.5">
              <JobCard customer="Reyes, Ana" address="22 Cactus Ln, Mesa" systemKw="10.5 kW" status="review" statusLabel="Review" photosDone={8} photosTotal={8} />
              <JobCard customer="Walker, Tim" address="9 Ridge Rd, Gilbert" systemKw="11.2 kW" status="photos" photosDone={5} photosTotal={9} />
            </div>
          </MockupFrame>
        </MockupSection>
      </div>
    </div>
  </section>

  <!-- FEATURE: PAYROLL WITHOUT SPREADSHEETS -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <MockupSection class="md:order-1 order-2" caption="Lock the week. Pay the team. Done.">
          <MockupFrame title="Payroll" subtitle="Wk 24 · $12,840 to pay" size="md">
            <div class="grid grid-cols-3 gap-2">
              <KPICard label="Crew" value="9" />
              <KPICard label="Line items" value="38" />
              <KPICard label="Total" value="$12.8k" accent />
            </div>
            <div class="space-y-1.5">
              <CommissionRow customer="Castillo, Diego" amount="$2,140" status="paid" statusLabel="Locked" date="Wk 24" />
              <CommissionRow customer="O'Brien, Pat" amount="$1,860" status="paid" statusLabel="Locked" date="Wk 24" />
              <CommissionRow customer="Singh, Aman" amount="$1,720" status="pending" statusLabel="Review" date="Wk 24" />
              <CommissionRow customer="Tran, Kevin" amount="$1,540" status="pending" statusLabel="Review" date="Wk 24" />
              <CommissionRow customer="Diaz, Luis" amount="$1,420" status="pending" statusLabel="Review" date="Wk 24" />
            </div>
          </MockupFrame>
        </MockupSection>
        <div class="md:order-2 order-1">
          <SectionEyebrow label="Payroll without spreadsheets" number="06" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            Retire
            <span class="accent-cursive text-brand-primary text-[1.15em]">the spreadsheet</span>
            for good.
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            Pay rules live in 365, not in your head. Open the week, review
            the line items, lock it, and pay. Adjustments, deductions, and
            bonuses ride along — and the whole crew sees their pay the
            moment the week closes.
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Week-grouped pay with locked / unlocked statuses</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Audit trail on every adjustment</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Export to QuickBooks, Gusto, or CSV</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CROSS-LINK -->
  <section class="hairline-top hairline-bottom bg-brand-paper/40">
    <div class="container-prose py-10 md:py-14 text-center">
      <p class="text-sm md:text-base text-brand-muted">
        Sell solar too?
        <a href="/sales/" class="text-brand-primary hover:text-brand-primaryDark underline underline-offset-4 ml-1">
          See 365 for sales reps &rarr;
        </a>
      </p>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="hairline-top">
    <div class="container-prose py-24 md:py-32 text-center">
      <h2 class="text-4xl md:text-6xl lg:text-7xl mb-8 max-w-3xl mx-auto text-brand-ink">
        Ready to <span class="accent-cursive text-brand-primary text-[1.15em]">run the field?</span>
      </h2>
      <p class="text-lg md:text-xl text-brand-muted max-w-xl mx-auto mb-10">
        365 is free to download. Your ops admin invites you in.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4">
        <CTAButton href="#get-the-app" variant="primary" size="lg">
          Get on the App Store
        </CTAButton>
        <CTAButton href="#get-the-app" variant="ghost" size="lg">
          Get on Google Play
        </CTAButton>
      </div>
      <p class="mt-8 text-sm text-brand-subtle">
        Already on 365? <a href="https://threesixfive.app" class="text-brand-primary hover:text-brand-primaryDark underline underline-offset-4">Sign in on the web</a>.
      </p>
    </div>
  </section>
</Layout>
