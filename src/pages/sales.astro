---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import MockupSection from '../components/mockups/MockupSection.astro';
import RealScreenshot from '../components/RealScreenshot.astro';
---

<Layout
  title="365 for Sales — Track every commission. Beat every goal."
  description="365 gives solar sales reps real-time commissions, adaptive goals, and a recruiting engine — all in one app. Every deal, every dollar, every status."
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 pointer-events-none">
      <div class="absolute -top-40 -right-20 w-[40rem] h-[40rem] bg-brand-primary/20 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -left-32 w-[30rem] h-[30rem] bg-brand-primary/10 rounded-full blur-3xl"></div>
    </div>

    <div class="container-prose pt-20 md:pt-28 pb-16 md:pb-20">
      <div class="grid md:grid-cols-[1.2fr_1fr] gap-12 md:gap-16 items-center">
        <div>
          <p class="text-xs uppercase tracking-[0.22em] text-brand-primary font-medium mb-4 animate-fade-in">
            01 · For Sales
          </p>
          <h1 class="display-xl text-5xl sm:text-6xl md:text-7xl lg:text-[5rem] mb-6 md:mb-8 animate-fade-up">
            Track every commission.<br />
            <span class="accent-cursive text-brand-primary text-[1.25em]">Beat every goal.</span>
          </h1>
          <p class="text-lg md:text-xl text-brand-muted max-w-xl leading-snug mb-10 animate-fade-up" style="animation-delay:80ms">
            365 is the operating system for solar sales reps. Real-time
            commissions on every deal, adaptive goals you actually hit, and
            a recruiting engine that grows the team while you sleep.
          </p>

          <div id="get-the-app" class="flex flex-wrap items-center gap-3 md:gap-4 animate-fade-up" style="animation-delay:160ms">
            <CTAButton href="https://threesixfive.app" variant="primary" size="lg">
              Open the 365 app
            </CTAButton>
            <CTAButton href="mailto:threesixfive@luminate.solar" variant="ghost" size="lg">
              Ask for an invite
            </CTAButton>
          </div>
          <p class="mt-4 text-xs uppercase tracking-[0.22em] text-brand-subtle animate-fade-up" style="animation-delay:220ms">
            iPhone &amp; Android &middot; Runs right in your browser
          </p>
        </div>

        <div class="hidden md:block animate-fade-up" style="animation-delay:120ms">
          <RealScreenshot
            src="/screenshots/sales-admin-dashboard.png"
            alt="365 admin dashboard — Total Commissions $63,750 with team activity KPIs."
            size="md"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- HERO MOCKUP CAPTION (mobile only — desktop shows mockup inline) -->
  <section class="md:hidden container-prose pb-12">
    <RealScreenshot
      src="/screenshots/sales-admin-dashboard.png"
      alt="365 admin dashboard — team management overview with KPIs."
      size="sm"
    />
    <p class="mt-6 text-center text-sm text-brand-muted">
      Real-time commissions. Every account, every week, every status.
    </p>
  </section>

  <!-- FEATURE: REAL-TIME COMMISSIONS -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <div>
          <SectionEyebrow label="Real-time commissions" number="02" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            Every deal,
            <span class="accent-cursive text-brand-primary text-[1.5em]">every status,</span>
            in your pocket.
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            No more guessing what payroll is going to look like. 365 syncs
            with the system of record so every deal, override, and chargeback
            shows up the moment it changes. Tap any commission to see exactly
            how it was calculated.
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Live status pills — pending, paid, in review, cancelled</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Override badges and team commissions flagged automatically</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Filter by month, status, customer, or system size</span></li>
          </ul>
        </div>
        <MockupSection caption="A live feed of every account you sold.">
          <RealScreenshot
            src="/screenshots/sales-commissions.png"
            alt="365 commissions — All Company Commissions table with paid + pending status."
            size="md"
          />
        </MockupSection>
      </div>
    </div>
  </section>

  <!-- FEATURE: GOALS THAT ADAPT -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <MockupSection class="md:order-1 order-2" caption="Set the target. Watch the bar fill.">
          <RealScreenshot
            src="/screenshots/sales-goals.png"
            alt="365 goals — Commission, Install, and Recruiting goals with progress bars."
            size="md"
          />
        </MockupSection>
        <div class="md:order-2 order-1">
          <SectionEyebrow label="Goals that adapt" number="03" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            Set them.
            <span class="accent-cursive text-brand-primary text-[1.5em]">Beat them.</span>
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            Personal sales goals. Commission targets. Install counts. Even
            non-work goals like "save for a new truck." 365 watches your
            commission stream in real time and tells you exactly how close
            you are — without you ever opening a spreadsheet.
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Goal types: commissions, installs, recruiting, custom</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Progress bars update automatically as deals close</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Public goals show leaderboard rank vs. the team</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE: TEAM RECRUITING -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <div>
          <SectionEyebrow label="Team recruiting" number="04" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            Grow the team
            <span class="accent-cursive text-brand-primary text-[1.5em]">on autopilot.</span>
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            Send a personal invite link to anyone — text, email, in-app. New
            reps land in a guided onboarding flow that walks them through
            their first deal. You see exactly who joined from where and
            who's stuck.
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>One personal link, infinite invites</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Onboarding progress bar per recruit</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Conversion analytics: invites &rarr; active reps</span></li>
          </ul>
        </div>
        <MockupSection caption="Track every recruit from invite to first deal.">
          <RealScreenshot
            src="/screenshots/sales-recruits.png"
            alt="365 recruiting — My Recruits with onboarding progress badges."
            size="md"
          />
        </MockupSection>
      </div>
    </div>
  </section>

  <!-- FEATURE: ANALYTICS / INVITES -->
  <section class="hairline-top">
    <div class="container-prose py-20 md:py-28">
      <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
        <MockupSection class="md:order-1 order-2" caption="Know your numbers cold.">
          <RealScreenshot
            src="/screenshots/sales-invites.png"
            alt="365 invites — recipient list with role and status badges."
            size="md"
          />
        </MockupSection>
        <div class="md:order-2 order-1">
          <SectionEyebrow label="Funnel you can act on" number="05" />
          <h2 class="text-4xl md:text-5xl mb-6 text-brand-ink">
            From invite to
            <span class="accent-cursive text-brand-primary text-[1.5em]">first deal,</span>
            tracked.
          </h2>
          <p class="text-base md:text-lg text-brand-muted leading-relaxed mb-6">
            Every invite you send shows up here. Who tapped the link, who
            started onboarding, who closed their first deal — and where
            people get stuck. The funnel that actually moves your paycheck.
          </p>
          <ul class="space-y-2 text-sm text-brand-muted">
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Per-invite status: sent, opened, joined, onboarding, active</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Role tagged on every invite — sales rep, setter, crew lead</span></li>
            <li class="flex gap-2"><span class="text-brand-primary mt-1">&bull;</span><span>Conversion totals roll up to your monthly goal automatically</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CROSS-LINK -->
  <section class="hairline-top hairline-bottom bg-brand-paper/40">
    <div class="container-prose py-10 md:py-14 text-center">
      <p class="text-sm md:text-base text-brand-muted">
        Lead a crew too?
        <a href="/install/" class="text-brand-primary hover:text-brand-primaryDark underline underline-offset-4 ml-1">
          See what 365 does for install &amp; ops &rarr;
        </a>
      </p>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="hairline-top">
    <div class="container-prose py-24 md:py-32 text-center">
      <h2 class="text-4xl md:text-6xl lg:text-7xl mb-8 max-w-3xl mx-auto text-brand-ink">
        Ready to <span class="accent-cursive text-brand-primary text-[1.5em]">close more?</span>
      </h2>
      <p class="text-lg md:text-xl text-brand-muted max-w-xl mx-auto mb-10">
        365 runs on any phone, right in the browser. Your admin invites you in.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4">
        <CTAButton href="https://threesixfive.app" variant="primary" size="lg">
          Open the 365 app
        </CTAButton>
        <CTAButton href="mailto:threesixfive@luminate.solar" variant="ghost" size="lg">
          Ask for an invite
        </CTAButton>
      </div>
      <p class="mt-8 text-sm text-brand-subtle">
        Already on 365? <a href="https://threesixfive.app" class="text-brand-primary hover:text-brand-primaryDark underline underline-offset-4">Sign in on the web</a>.
      </p>
    </div>
  </section>
</Layout>
